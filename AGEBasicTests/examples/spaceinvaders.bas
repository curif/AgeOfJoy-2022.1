10 ' ==========================================
20 ' SPACE INVADERS (PIXEL EDITION)
30 ' ==========================================
40 SETCPU 100
50 
60 ' --- INIT GLOBALS ---
70 LET W = DSCREENWIDTH()
80 LET H = DSCREENHEIGHT()
90 LET ALIEN_COLS = 6
100 LET ALIEN_ROWS = 3
110 LET MAX_BULLETS = 3
120 LET ALIEN_DIR = 1 ' 1 for right, -1 for left
130 LET ALIEN_SPEED = 2
140 LET SCORE = 0
150 LET GAME_OVER = 0
160 
170 ' --- PLAYER INIT ---
180 LET PX = W / 2
190 LET PY = H - 20
200 LET P_WIDTH = 20
210 LET P_HEIGHT = 10
220 
230 ' --- ARRAYS ---
240 DIM ALIENS[ALIEN_COLS, ALIEN_ROWS]
250 DIM BULLETS_X[MAX_BULLETS]
260 DIM BULLETS_Y[MAX_BULLETS]
270 DIM BULLETS_ACTIVE[MAX_BULLETS]
280 
290 ' --- COLORS (R, G, B) ---
300 DIM COL_GREEN[3] : LETS COL_GREEN[0], COL_GREEN[1], COL_GREEN[2] = 0, 255, 0
310 DIM COL_RED[3] : LETS COL_RED[0], COL_RED[1], COL_RED[2] = 255, 0, 0
320 DIM COL_WHITE[3] : LETS COL_WHITE[0], COL_WHITE[1], COL_WHITE[2] = 255, 255, 255
330 DIM COL_BLACK[3] : LETS COL_BLACK[0], COL_BLACK[1], COL_BLACK[2] = 0, 0, 0
340 
350 ' --- SETUP GAME ---
360 GOSUB 1000 ' Spawn Aliens
370 GOSUB 1200 ' Clear Bullets
380 CLS()
390 
400 ' ==========================================
410 ' MAIN GAME LOOP
420 ' ==========================================
430 IF GAME_OVER = 1 THEN GOTO 2000
440 
450 ' 1. Handle Input
460 IF CONTROLACTIVE("JOYPAD_LEFT_0") && PX > P_WIDTH THEN LET PX = PX - 3
470 IF CONTROLACTIVE("JOYPAD_RIGHT_0") && PX < W - P_WIDTH THEN LET PX = PX + 3
480 IF CONTROLACTIVE("JOYPAD_B_0") THEN GOSUB 1300 ' Fire
490 
500 ' 2. Update Bullets
510 GOSUB 1400
520 
530 ' 3. Update Aliens (Move & Collision)
540 GOSUB 1600
550 
560 ' 4. Draw Screen
570 GOSUB 3000
580 
590 ' Control frame rate
600 SLEEP 0.03
610 GOTO 430
620 
630 
640 ' ==========================================
650 ' SUBROUTINES
660 ' ==========================================
670 
680 ' --- SPAWN ALIENS ---
1000 FOR X = 0 TO ALIEN_COLS - 1
1010   FOR Y = 0 TO ALIEN_ROWS - 1
1020     LET ALIENS[X, Y] = 1 ' 1 = Alive, 0 = Dead
1030   NEXT Y
1040 NEXT X
1050 LET ALIEN_OFFSET_X = 20
1060 LET ALIEN_OFFSET_Y = 30
1070 LET ALIEN_W = 16
1080 LET ALIEN_H = 12
1090 LET ALIEN_SPACING = 24
1100 RETURN
1110 
1120 ' --- CLEAR BULLETS ---
1200 FOR I = 0 TO MAX_BULLETS - 1
1210   LET BULLETS_ACTIVE[I] = 0
1220 NEXT I
1230 RETURN
1240 
1250 ' --- FIRE BULLET ---
1300 FOR I = 0 TO MAX_BULLETS - 1
1310   IF BULLETS_ACTIVE[I] = 0 THEN GOTO 1340
1320 NEXT I
1330 RETURN ' No free bullets
1340 ' Found a free bullet, spawn it
1350 LETS BULLETS_ACTIVE[I], BULLETS_X[I], BULLETS_Y[I] = 1, PX, PY - 5
1360 RETURN
1370 
1380 ' --- UPDATE BULLETS ---
1400 FOR I = 0 TO MAX_BULLETS - 1
1410   IF BULLETS_ACTIVE[I] = 0 THEN GOTO 1490
1420   LET BULLETS_Y[I] = BULLETS_Y[I] - 5
1430   IF BULLETS_Y[I] < 0 THEN LET BULLETS_ACTIVE[I] = 0 : GOTO 1490
1440   
1450   ' Check Alien Collision (Pixel bounding box)
1460   LET HIT_X = INT((BULLETS_X[I] - ALIEN_OFFSET_X + (ALIEN_SPACING/2)) / ALIEN_SPACING)
1470   LET HIT_Y = INT((BULLETS_Y[I] - ALIEN_OFFSET_Y + (ALIEN_SPACING/2)) / ALIEN_SPACING)
1480   IF HIT_X >= 0 && HIT_X < ALIEN_COLS && HIT_Y >= 0 && HIT_Y < ALIEN_ROWS && ALIENS[HIT_X, HIT_Y] = 1 THEN LETS ALIENS[HIT_X, HIT_Y], BULLETS_ACTIVE[I], SCORE = 0, 0, SCORE + 10
1490 NEXT I
1500 RETURN
1510 
1520 ' --- UPDATE ALIENS ---
1600 LET ALIEN_OFFSET_X = ALIEN_OFFSET_X + (ALIEN_DIR * ALIEN_SPEED)
1610 
1620 ' Check wall collision
1630 IF ALIEN_OFFSET_X > W - (ALIEN_COLS * ALIEN_SPACING) || ALIEN_OFFSET_X < 10 THEN LETS ALIEN_DIR, ALIEN_OFFSET_Y = ALIEN_DIR * -1, ALIEN_OFFSET_Y + 10
1640 
1650 ' Check if aliens reached player
1660 IF ALIEN_OFFSET_Y + (ALIEN_ROWS * ALIEN_SPACING) >= PY THEN LET GAME_OVER = 1
1670 
1680 ' Check win condition
1690 LET ALIEN_COUNT = 0
1700 FOR X = 0 TO ALIEN_COLS - 1
1710   FOR Y = 0 TO ALIEN_ROWS - 1
1720     LET ALIEN_COUNT = ALIEN_COUNT + ALIENS[X, Y]
1730   NEXT Y
1740 NEXT X
1750 IF ALIEN_COUNT = 0 THEN LETS ALIEN_SPEED, SCORE = ALIEN_SPEED + 1, SCORE + 100 : GOSUB 1000 ' Next Level
1760 RETURN
1770 
1780 ' ==========================================
1790 ' GAME OVER
1800 ' ==========================================
2000 CLS()
2010 PRINTCENTERED 10, "GAME OVER", 0, 0
2020 PRINTCENTERED 12, "SCORE: " + STR(SCORE), 0, 0
2030 PRINTCENTERED 15, "PRESS B TO RESTART", 0, 1
2040 SLEEP 0.1
2050 IF CONTROLACTIVE("JOYPAD_B_0") THEN LETS SCORE, GAME_OVER = 0, 0 : GOSUB 1000 : GOSUB 1200 : CLS() : GOTO 430
2060 GOTO 2000
2070 
2080 ' ==========================================
2090 ' DRAW ROUTINE (PIXEL PERFECT)
2100 ' ==========================================
3000 CLS()
3010 
3020 ' Helper Arrays for Line Drawing
3030 DIM P1[2]
3040 DIM P2[2]
3050 DIM P3[2]
3060 
3070 ' Draw Player (Green Triangle Pointing Up)
3080 ' Tip
3090 LETS P1[0], P1[1] = INT(PX), INT(PY - P_HEIGHT)
3100 ' Bottom Left
3110 LETS P2[0], P2[1] = INT(PX - (P_WIDTH/2)), INT(PY)
3120 ' Bottom Right
3130 LETS P3[0], P3[1] = INT(PX + (P_WIDTH/2)), INT(PY)
3140 DLINE P1, P2, COL_GREEN, 0
3150 DLINE P2, P3, COL_GREEN, 0
3160 DLINE P3, P1, COL_GREEN, 0
3170 
3180 ' Draw Aliens (Red Triangles Pointing Down)
3190 FOR X = 0 TO ALIEN_COLS - 1
3200   FOR Y = 0 TO ALIEN_ROWS - 1
3210     IF ALIENS[X, Y] = 1 THEN GOSUB 4000
3220   NEXT Y
3230 NEXT X
3240 
3250 ' Draw Bullets (White Lines)
3260 FOR I = 0 TO MAX_BULLETS - 1
3270   IF BULLETS_ACTIVE[I] = 1 THEN LETS P1[0], P1[1], P2[0], P2[1] = INT(BULLETS_X[I]), INT(BULLETS_Y[I]), INT(BULLETS_X[I]), INT(BULLETS_Y[I] + 6) : DLINE P1, P2, COL_WHITE, 0
3280 NEXT I
3290 
3300 ' Draw UI
3310 PRINT 0, 0, "SCORE: " + STR(SCORE), 0, 1 ' Commit frame
3320 RETURN
3330 
3340 ' --- DRAW ALIEN SUBROUTINE ---
4000 LET AX = INT(ALIEN_OFFSET_X + (X * ALIEN_SPACING))
4010 LET AY = INT(ALIEN_OFFSET_Y + (Y * ALIEN_SPACING))
4020 ' Top Left
4030 LETS P1[0], P1[1] = AX, AY
4040 ' Top Right
4050 LETS P2[0], P2[1] = AX + ALIEN_W, AY
4060 ' Bottom Tip
4070 LETS P3[0], P3[1] = AX + (ALIEN_W/2), AY + ALIEN_H
4080 DLINE P1, P2, COL_RED, 0
4090 DLINE P2, P3, COL_RED, 0
4100 DLINE P3, P1, COL_RED, 0
4110 RETURN