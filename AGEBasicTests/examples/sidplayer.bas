10  ' ============================================================
20  ' SID PLAYER DEMO
30  ' Controls:
40  '   JOYPAD_B    - pause / resume music
50  '   JOYPAD_A    - next sub-song
60  '   JOYPAD_X    - stop everything and exit
70  '   JOYPAD_UP   - music volume up
80  '   JOYPAD_DOWN - music volume down
90  ' ============================================================
100 CALL SETCPU(50)
110
120 LET MUSIC$ = "music"
130 LET MPATH$ = "C:\Users\curif\cabs\music\James_Bond.sid"
140 LET MVOL   = 70
150 LET CURSONG = 1
160 LET PAUSED  = 0
170
180 ' ── Load music
190 CLS
200 FGCOLOR 0, 200, 255
210 PRINTLN "Loading..."
220 SHOW
230
240 IF NOT(fileexists(MPATH$)) THEN GOTO 6000
250 SIDLOAD MUSIC$, MPATH$
260 IF SIDSTATUS(MUSIC$) = 0 THEN GOTO 6100
270
280 ' ── Read music metadata
290 LET TITLE$  = SIDTITLE(MUSIC$)
300 LET AUTHOR$ = SIDAUTHOR(MUSIC$)
310 LET YEAR$   = SIDRELEASED(MUSIC$)
320 LET NSONGS  = SIDCOUNT(MUSIC$)
330 LET CURSONG = SIDDEFAULTSONG(MUSIC$)
340
350 ' ── Start music
360 SIDVOLUME MUSIC$, MVOL
370 SIDPLAY MUSIC$, CURSONG
380
390 ' ── Register events
400 ONEVENT ONTIMER(0.5) GOTO 2000
410 ONEVENT ONCONTROL("JOYPAD_B",    "pressed") GOTO 3000
420 ONEVENT ONCONTROL("JOYPAD_A",    "pressed") GOTO 3200
430 ONEVENT ONCONTROL("JOYPAD_X",    "pressed") GOTO 5000
440 ONEVENT ONCONTROL("JOYPAD_UP",   "pressed") GOTO 3700
450 ONEVENT ONCONTROL("JOYPAD_DOWN", "pressed") GOTO 3900
460 END

470 ' ── Draw screen (timer event)
2000 CLS
2010 FGCOLOR 0, 200, 255
2020 PRINTLN "[ SID PLAYER ]"
2030 FGCOLOR 255, 255, 100
2040 PRINTLN TITLE$
2050 FGCOLOR 180, 180, 180
2060 PRINTLN AUTHOR$
2070 PRINTLN YEAR$
2080 FGCOLOR 100, 255, 100
2090 PRINTLN "Song " + str(CURSONG) + " / " + str(NSONGS)
2100 FGCOLOR 200, 200, 200
2110 PRINTLN "Music vol: " + str(MVOL) + "%"
2120 LET MST = SIDSTATUS(MUSIC$)
2130 IF MST = 2 THEN FGCOLOR 0, 255, 0   : PRINTLN ">> PLAYING"
2140 IF MST = 3 THEN FGCOLOR 255, 200, 0 : PRINTLN "|| PAUSED"
2150 IF MST = 1 THEN FGCOLOR 255, 80, 80 : PRINTLN "[] STOPPED"
2160 FGCOLOR 100, 100, 100
2170 PRINTLN ""
2180 PRINTLN "B=pause  A=next  X=stop  UP/DOWN=vol"
2190 SHOW
2200 END

2210 ' ── Pause / Resume music
3000 IF PAUSED = 1 THEN GOTO 3050
3010 SIDPAUSE MUSIC$
3020 LET PAUSED = 1
3030 END
3050 SIDRESUME MUSIC$
3060 LET PAUSED = 0
3070 END

3080 ' ── Next sub-song
3200 LET CURSONG = CURSONG + 1
3210 IF CURSONG > NSONGS THEN LET CURSONG = 1
3220 LET PAUSED = 0
3230 SIDPLAY MUSIC$, CURSONG
3240 END

3250 ' ── Music volume up
3700 LET MVOL = MVOL + 10
3710 IF MVOL > 100 THEN LET MVOL = 100
3720 SIDVOLUME MUSIC$, MVOL
3730 END

3740 ' ── Music volume down
3900 LET MVOL = MVOL - 10
3910 IF MVOL < 0 THEN LET MVOL = 0
3920 SIDVOLUME MUSIC$, MVOL
3930 END

3940 ' ── Stop and cleanup
5000 SIDSTOP MUSIC$
5010 SIDUNLOAD MUSIC$
5020 CLS
5030 FGCOLOR 255, 100, 100
5040 PRINTLN "Stopped."
5050 SHOW
5060 SHUTDOWN

5070 ' ── Error: music file not found
6000 CLS
6010 FGCOLOR 255, 80, 80
6020 PRINTLN "ERROR: music file not found:"
6030 PRINTLN MPATH$
6040 SHOW
6050 SLEEP 15
6060 END

6070 ' ── Error: SID load failed
6100 CLS
6110 FGCOLOR 255, 80, 80
6120 PRINTLN "ERROR: SID load failed."
6130 PRINTLN "The file may be corrupt"
6140 PRINTLN "or not a valid PSID/RSID."
6150 SHOW
6160 SLEEP 15
6170 SHUTDOWN
