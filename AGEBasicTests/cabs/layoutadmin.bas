10 REM ============================================================
11 REM LAYOUT ADMINISTRATION - manage registry.yaml backup slots 0-9
12 REM Event-driven: registers ONCONTROL handlers once, then idles.
13 REM Controls: DPAD UP/DOWN move menu cursor, LEFT/RIGHT change slot
14 REM number, A/TRIGGER confirm, B back/cancel, Y quit, X toggle help.
15 REM ============================================================
100 LET TITLE = "LAYOUT ADMINISTRATION"
110 LET DBPATH = CABINETSDBPATH()
120 LET REGPATH = COMBINEPATH(DBPATH, "registry.yaml")
130 LET WIDTH = SCREENWIDTH() : LET HEIGHT = SCREENHEIGHT()
140 LET STATE = 0
150 LET MENUCURSOR = 0
160 LET LAYOUTNUM = 0
170 LET SHOWHELP = 0
180 LET PENDINGACTION = ""
190 LET RESULTMSG = ""
200 GOSUB 8510
210 GOSUB 1010
220 ONEVENT ONCONTROL("JOYPAD_Y", "pressed") GOTO 9105
230 ONEVENT ONCONTROL("JOYPAD_X", "pressed") GOTO 9115
240 ONEVENT ONCONTROL("JOYPAD_UP", "pressed") GOTO 9210
250 ONEVENT ONCONTROL("JOYPAD_DOWN", "pressed") GOTO 9310
260 ONEVENT ONCONTROL("JOYPAD_LEFT", "pressed") GOTO 9410
270 ONEVENT ONCONTROL("JOYPAD_RIGHT", "pressed") GOTO 9510
280 ONEVENT ONCONTROL("JOYPAD_B", "pressed") GOTO 9610
290 ONEVENT ONCONTROL("JOYPAD_A", "pressed") GOTO 9710
300 ONEVENT ONCONTROL("JOYPAD_L", "pressed") GOTO 9710
310 ONEVENT ONCONTROL("JOYPAD_R", "pressed") GOTO 9710
320 END

1000 REM ---------- REDRAW DISPATCHER (GOSUB'd, not an event target) ----------
1010 IF STATE = 0 THEN GOSUB 2010 : RETURN
1020 IF STATE = 1 THEN GOSUB 3010 : RETURN
1030 IF STATE = 2 THEN GOSUB 4110 : RETURN
1040 GOSUB 4510 : RETURN

2000 REM ---------- RENDER: MAIN MENU ----------
2010 CLS
2020 PRINTCENTERED 0, TITLE, 0
2030 PRINT 2, 3, "RECOVER LAYOUT", IIF(MENUCURSOR = 0, 1, 0), 0
2040 PRINT 2, 4, "SAVE LAYOUT", IIF(MENUCURSOR = 1, 1, 0), 0
2050 PRINT 2, 5, "DELETE LAYOUT", IIF(MENUCURSOR = 2, 1, 0), 0
2060 PRINT 2, 6, "EXIT", IIF(MENUCURSOR = 3, 1, 0), 0
2070 PRINT 0, HEIGHT - 1, LAYOUTSLINE, 0, 0
2080 IF SHOWHELP = 1 THEN GOSUB 8610
2090 SHOW
2100 RETURN

3000 REM ---------- RENDER: NUMBER PICKER ----------
3010 CLS
3020 PRINTCENTERED 0, TITLE, 0
3030 PRINTCENTERED 2, "ACTION: " + PENDINGACTION + " LAYOUT", 0
3040 LET SLOTFILE = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
3050 LET SLOTEXISTS = FILEEXISTS(SLOTFILE)
3060 LET SLOTHINT = IIF(SLOTEXISTS = 1, "[EXISTS]", "[EMPTY]")
3070 PRINTCENTERED 5, "< " + STR(LAYOUTNUM) + " >  registry-" + STR(LAYOUTNUM) + ".yaml " + SLOTHINT, 1
3075 PRINTCENTERED 7, "LEFT/RIGHT: CHANGE SLOT (0-9)", 0
3080 PRINT 0, HEIGHT - 1, LAYOUTSLINE, 0, 0
3090 IF SHOWHELP = 1 THEN GOSUB 8610
3100 SHOW
3110 RETURN

4100 REM ---------- RENDER: CONFIRM SCREEN ----------
4110 CLS
4120 PRINTCENTERED 0, TITLE, 0
4130 LET SLOTFILE = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
4140 LET SLOTEXISTS = FILEEXISTS(SLOTFILE)
4150 IF PENDINGACTION = "RECOVER" THEN LET CONFIRMTEXT = "OVERWRITE registry.yaml WITH SLOT " + STR(LAYOUTNUM) + " ?"
4160 IF PENDINGACTION = "SAVE" && SLOTEXISTS = 1 THEN LET CONFIRMTEXT = "SLOT " + STR(LAYOUTNUM) + " EXISTS - OVERWRITE?"
4170 IF PENDINGACTION = "SAVE" && SLOTEXISTS = 0 THEN LET CONFIRMTEXT = "SAVE CURRENT LAYOUT INTO SLOT " + STR(LAYOUTNUM) + " ?"
4180 IF PENDINGACTION = "DELETE" THEN LET CONFIRMTEXT = "DELETE registry-" + STR(LAYOUTNUM) + ".yaml PERMANENTLY?"
4190 PRINTCENTERED 4, CONFIRMTEXT, 0
4200 PRINTCENTERED 6, "A / TRIGGER: CONFIRM     B: CANCEL", 1
4210 PRINT 0, HEIGHT - 1, LAYOUTSLINE, 0, 0
4220 IF SHOWHELP = 1 THEN GOSUB 8610
4230 SHOW
4240 RETURN

4500 REM ---------- RENDER: MESSAGE SCREEN ----------
4510 CLS
4520 PRINTCENTERED 0, TITLE, 0
4530 PRINTCENTERED 5, RESULTMSG, 1
4540 PRINTCENTERED 7, "PRESS A TO CONTINUE", 0
4550 PRINT 0, HEIGHT - 1, LAYOUTSLINE, 0, 0
4560 IF SHOWHELP = 1 THEN GOSUB 8610
4570 SHOW
4580 RETURN

6000 REM ---------- ADVANCE LAYOUTNUM TO NEXT EXISTING SLOT IN DIRECTION STEPDIR ----------
6010 LET TRIES = 0
6020 LET LAYOUTNUM = MOD(LAYOUTNUM + STEPDIR + 10, 10)
6030 LET TRIES = TRIES + 1
6040 LET CHK = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
6050 IF FILEEXISTS(CHK) = 1 THEN RETURN
6060 IF TRIES >= 10 THEN RETURN
6070 GOTO 6020

6100 REM ---------- SNAP LAYOUTNUM TO AN EXISTING SLOT IF CURRENT ONE IS MISSING ----------
6110 LET CHK = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
6120 IF FILEEXISTS(CHK) = 1 THEN RETURN
6130 LET STEPDIR = 1
6140 GOSUB 6010
6150 RETURN

7000 REM ---------- PERFORM RECOVER: registry-N.yaml -> registry.yaml ----------
7010 LET COPYSRC = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
7020 LET COPYOK = FILECOPY(COPYSRC, REGPATH)
7030 IF COPYOK = 0 THEN LET RESULTMSG = "RECOVER FAILED FOR SLOT " + STR(LAYOUTNUM) : RETURN
7040 CALL CABDBRELOAD()
7050 LET RESULTMSG = "LAYOUT " + STR(LAYOUTNUM) + " RECOVERED AND RELOADED"
7060 RETURN

7100 REM ---------- PERFORM SAVE: registry.yaml -> registry-N.yaml ----------
7110 LET COPYDST = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
7120 LET COPYOK = FILECOPY(REGPATH, COPYDST)
7130 IF COPYOK = 0 THEN LET RESULTMSG = "SAVE FAILED FOR SLOT " + STR(LAYOUTNUM) : RETURN
7140 LET RESULTMSG = "LAYOUT SAVED TO SLOT " + STR(LAYOUTNUM)
7150 GOSUB 8510
7160 RETURN

7200 REM ---------- PERFORM DELETE ----------
7210 LET DELFILE = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
7220 IF FILEDELETE(DELFILE) THEN LET RESULTMSG = "SLOT " + STR(LAYOUTNUM) + " DELETED" : GOSUB 8510 : RETURN
7230 LET RESULTMSG = "COULD NOT DELETE SLOT " + STR(LAYOUTNUM)
7240 RETURN

8500 REM ---------- BUILD "LAYOUTS: n,n,n" STATUS STRING ----------
8510 LET LAYOUTSLINE = "LAYOUTS: "
8520 LET FOUNDANY = 0
8530 FOR N = 0 TO 9
8540 LET SLOTPATH = COMBINEPATH(DBPATH, "registry-" + STR(N) + ".yaml")
8550 IF FILEEXISTS(SLOTPATH) THEN LET LAYOUTSLINE = LAYOUTSLINE + IIF(FOUNDANY = 1, ",", "") + STR(N) : LET FOUNDANY = 1
8560 NEXT N
8570 IF FOUNDANY = 0 THEN LET LAYOUTSLINE = LAYOUTSLINE + "(NONE)"
8580 RETURN

8600 REM ---------- DRAW HELP LEGEND LINE (row HEIGHT-2) ----------
8610 PRINT 0, HEIGHT - 2, "A/TRIG:OK  B:BACK  Y:QUIT  X:HELP  DPAD:MOVE", 0, 0
8620 RETURN

9100 REM ---------- EVENT: JOYPAD_Y (quick quit, any state) ----------
9105 END

9110 REM ---------- EVENT: JOYPAD_X (toggle help legend) ----------
9115 LET SHOWHELP = 1 - SHOWHELP
9120 GOSUB 1010
9125 END

9200 REM ---------- EVENT: JOYPAD_UP ----------
9210 IF STATE <> 0 THEN END
9220 LET MENUCURSOR = MOD(MENUCURSOR + 3, 4)
9230 GOSUB 1010
9240 END

9300 REM ---------- EVENT: JOYPAD_DOWN ----------
9310 IF STATE <> 0 THEN END
9320 LET MENUCURSOR = MOD(MENUCURSOR + 1, 4)
9330 GOSUB 1010
9340 END

9400 REM ---------- EVENT: JOYPAD_LEFT ----------
9410 IF STATE <> 1 THEN END
9411 IF PENDINGACTION <> "SAVE" THEN GOTO 9416
9412 LET LAYOUTNUM = MOD(LAYOUTNUM + 9, 10)
9413 GOTO 9420
9416 LET STEPDIR = -1
9417 GOSUB 6010
9420 GOSUB 1010
9440 END

9500 REM ---------- EVENT: JOYPAD_RIGHT ----------
9510 IF STATE <> 1 THEN END
9511 IF PENDINGACTION <> "SAVE" THEN GOTO 9516
9512 LET LAYOUTNUM = MOD(LAYOUTNUM + 1, 10)
9513 GOTO 9520
9516 LET STEPDIR = 1
9517 GOSUB 6010
9520 GOSUB 1010
9540 END

9600 REM ---------- EVENT: JOYPAD_B (back/cancel/exit) ----------
9610 IF STATE = 0 THEN END
9620 IF STATE = 1 THEN LET STATE = 0 : GOSUB 1010 : END
9630 IF STATE = 2 THEN LET STATE = 1 : GOSUB 1010 : END
9640 LET STATE = 0 : LET MENUCURSOR = 0 : GOSUB 1010 : END

9700 REM ---------- EVENT: JOYPAD_A / JOYPAD_L / JOYPAD_R (confirm) ----------
9710 IF STATE = 0 THEN GOTO 9721
9711 IF STATE = 1 THEN GOTO 9751
9712 IF STATE = 2 THEN GOTO 9801
9713 GOTO 9910

9720 REM confirm in MAIN MENU: choose action or exit
9721 IF MENUCURSOR = 3 THEN END
9722 IF MENUCURSOR = 0 THEN LET PENDINGACTION = "RECOVER"
9723 IF MENUCURSOR = 1 THEN LET PENDINGACTION = "SAVE"
9724 IF MENUCURSOR = 2 THEN LET PENDINGACTION = "DELETE"
9725 IF PENDINGACTION <> "SAVE" && FOUNDANY = 0 THEN LET RESULTMSG = "NO SAVED LAYOUTS AVAILABLE" : LET STATE = 3 : GOSUB 1010 : END
9726 IF PENDINGACTION <> "SAVE" THEN GOSUB 6110
9727 LET STATE = 1
9728 GOSUB 1010
9729 END

9750 REM confirm in NUMBER PICKER: short-circuit if nothing to do, else go to confirm
9751 LET SLOTFILE = COMBINEPATH(DBPATH, "registry-" + STR(LAYOUTNUM) + ".yaml")
9752 LET SLOTEXISTS = FILEEXISTS(SLOTFILE)
9753 IF PENDINGACTION = "RECOVER" && SLOTEXISTS = 0 THEN LET RESULTMSG = "SLOT " + STR(LAYOUTNUM) + " DOES NOT EXIST - NOTHING TO RECOVER" : LET STATE = 3 : GOSUB 1010 : END
9754 IF PENDINGACTION = "DELETE" && SLOTEXISTS = 0 THEN LET RESULTMSG = "SLOT " + STR(LAYOUTNUM) + " DOES NOT EXIST - NOTHING TO DELETE" : LET STATE = 3 : GOSUB 1010 : END
9755 LET STATE = 2
9756 GOSUB 1010
9757 END

9800 REM confirm in CONFIRM screen: execute the pending action
9801 IF PENDINGACTION = "RECOVER" THEN GOSUB 7010 : GOTO 9820
9802 IF PENDINGACTION = "SAVE" THEN GOSUB 7110 : GOTO 9820
9803 GOSUB 7210
9820 LET STATE = 3
9821 GOSUB 1010
9822 END

9900 REM confirm in MESSAGE screen: return to main menu
9910 LET STATE = 0
9920 LET MENUCURSOR = 0
9930 GOSUB 1010
9940 END
