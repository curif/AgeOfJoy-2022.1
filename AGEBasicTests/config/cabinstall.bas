10 REM CABDBINSTALL / CABDBINSTALLSTATUS test
20 REM copy a cabinet zip (ex: galaga.zip) into CABINETSPATH() and set CABNAME
30 LET CABNAME = "galaga"
40 CLS
50 LET N = CABDBCOUNT()
60 PRINT 0, 0, "ZIP: " + STR(FILEEXISTS(COMBINEPATH(CABINETSPATH(), CABNAME + ".zip")))
70 PRINT 0, 1, "BEFORE: " + CABDBINSTALLSTATUS(CABNAME)
80 PRINT 0, 2, "COUNT: " + STR(N)
90 SHOW
100 CALL CABDBINSTALL(CABNAME)
110 LET T = 0
120 SLEEP 0.2
130 LET T = T + 1
140 IF CABDBINSTALLSTATUS(CABNAME) = "INSTALLING" THEN GOTO 120
150 PRINT 0, 3, "STATUS: " + CABDBINSTALLSTATUS(CABNAME) + " POLLS: " + STR(T)
160 PRINT 0, 4, "COUNT: " + STR(CABDBCOUNT()) + " (WAS " + STR(N) + ")"
170 PRINT 0, 5, "FOUND: " + CABDBSEARCH(CABNAME, "|")
180 PRINT 0, 6, "ZIP GONE: " + STR(1 - FILEEXISTS(COMBINEPATH(CABINETSPATH(), CABNAME + ".zip")))
190 PRINT 0, 8, "NOW CABDBINSTALL(TEST) MUST FAIL"
200 SHOW
210 CALL CABDBINSTALL("test")
220 PRINT 0, 9, "ERROR: TEST WAS ACCEPTED"
230 SHOW
240 END
