10 REM Internet Archive: list any file of an item and download the first one to downloads/.
20 LET ITEM = IALOAD("https://archive.org/details/cabinet-pack-1-1")
30 CLS
40 PRINT 0, 0, "Loading " + ITEM + "..."
50 SLEEP 0.5
60 IF IASTATUS(ITEM) = "LOADING" THEN GOTO 50
70 IF IASTATUS(ITEM) != "READY" THEN GOTO 400

100 CLS
110 PRINT 0, 0, "files: " + STR(IAINFO(ITEM, "files")) + "  into " + DOWNLOADSPATH()
120 LET FILES = IAFILES(ITEM, "*.zip")
130 IF LEN(FILES) = 0 THEN GOTO 400
140 FOR I = 0 TO LEN(FILES) - 1
150   IF I < 15 THEN PRINT 0, 2 + I, FILES[I] + " " + STR(IAFILEINFO(ITEM, FILES[I], "size")) + " dl=" + STR(IAFILEINFO(ITEM, FILES[I], "downloaded"))
160 NEXT I
170 SHOW

200 LET FILE = IAFILEDOWNLOAD(ITEM, FILES[0])
210 SLEEP 0.5
220 PRINT 0, 20, "download " + STR(INT(IAFILEDOWNLOADPROGRESS(ITEM, FILES[0]))) + "%   "
230 SHOW
240 IF IAFILEDOWNLOADSTATUS(ITEM, FILES[0]) = "QUEUED" || IAFILEDOWNLOADSTATUS(ITEM, FILES[0]) = "DOWNLOADING" THEN GOTO 210
250 PRINT 0, 21, "result: " + IAFILEDOWNLOADSTATUS(ITEM, FILES[0]) + "   "
260 PRINT 0, 22, "downloaded=" + STR(IAFILEINFO(ITEM, FILES[0], "downloaded"))
270 SHOW
280 END

400 PRINT 0, 3, "nothing to list: " + IASTATUS(ITEM)
410 SHOW
420 END
