10 REM GitHub releases: list the AGE of Joy releases, download the newest apk and install it.
20 LET P = GHLOAD("https://github.com/curif/AgeOfJoy-2022.1", 5)
30 CLS
40 PRINT 0, 0, "Loading " + P + "... running " + APPVERSION()
50 SHOW
60 SLEEP 0.5
70 IF GHSTATUS(P) = "LOADING" THEN GOTO 60
80 IF GHSTATUS(P) != "READY" THEN GOTO 500

100 LET TAGS = GHRELEASES(P)
110 IF LEN(TAGS) = 0 THEN GOTO 500
120 FOR I = 0 TO LEN(TAGS) - 1
130   PRINT 0, 2 + I, TAGS[I] + " " + GHRELEASEINFO(P, TAGS[I], "date") + " pre=" + STR(GHRELEASEINFO(P, TAGS[I], "prerelease")) + " inst=" + STR(GHRELEASEINFO(P, TAGS[I], "installed")) + " " + STR(INT(GHRELEASEINFO(P, TAGS[I], "size") / 1048576)) + "MB"
140 NEXT I
150 SHOW

200 LET TAG = TAGS[0]
210 IF GHRELEASEINFO(P, TAG, "apk") = "" THEN PRINT 0, 10, "no apk in " + TAG : SHOW : END
220 LET APK = GHDOWNLOAD(P, TAG)
230 PRINT 0, 10, APK
240 SLEEP 1
250 PRINT 0, 11, "download " + STR(INT(GHDOWNLOADPROGRESS(P, TAG))) + "%   "
260 SHOW
270 IF GHDOWNLOADSTATUS(P, TAG) = "QUEUED" || GHDOWNLOADSTATUS(P, TAG) = "DOWNLOADING" THEN GOTO 240
280 PRINT 0, 12, "download result: " + GHDOWNLOADSTATUS(P, TAG) + " downloaded=" + STR(GHFILEINFO(P, TAG, "", "downloaded"))
290 SHOW
300 IF GHDOWNLOADSTATUS(P, TAG) != "COMPLETED" THEN END

400 LET R = APKINSTALL(APK)
410 PRINT 0, 13, "APKINSTALL: " + R + "   "
420 SHOW
430 IF R = "NOPERMISSION" THEN PRINT 0, 14, "enable 'install unknown apps' and run again" : SHOW : END
440 IF R != "STARTED" THEN END
450 SLEEP 0.5
460 PRINT 0, 14, "install " + APKINSTALLSTATUS() + " " + STR(INT(APKINSTALLPROGRESS())) + "%   "
470 SHOW
480 IF APKINSTALLSTATUS() = "COPYING" || APKINSTALLSTATUS() = "COMMITTING" || APKINSTALLSTATUS() = "WAITINGUSER" THEN GOTO 450
490 END

500 PRINT 0, 2, "no releases: " + GHSTATUS(P)
510 SHOW
520 END
