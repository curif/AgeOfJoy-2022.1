10 DATA "storage1", 10, 20, 30
20 DATA "storage1", 40, 50, &FF
30 DATA "complex", "a", "a"+"b", 10+10
50 CLS
60 PRINTLN "DATA/READ/RESTORE TEST"
100 READ "storage1", a,b,c,d,e,f
110 IF a <> 10 || b <> 20 || c <> 30 || 
       d <> 40 || e <> 50 || f <> 255 THEN PRINTLN "storage1 ERROR": SLEEP 4: END
120 PRINTLN "STORAGE1 VERIFIED."

200 READ "complex", c1, c2, c3
210 RESTORE "complex", 1
220 READ "complex", x
230 IF c1 <> "a" || c2 <> "ab" || c3 <> 20 || x <> c2 || x <> "ab" THEN PRINTLN "complex ERROR": SLEEP 4: END
240 PRINTLN "COMPLEX VERIFIED."

300 DIM COMPLEXARRAY[3]
305 RESTORE "complex"
310 FOR F=0 TO 2
320   READ "complex", COMPLEXARRAY[f]
330 NEXT F
335 IF COMPLEXARRAY[1] <> "ab" THEN PRINTLN "COMPLEXARRAY ERROR": SLEEP 4: END
340 PRINTLN "COPY TO ARRAY VERIFIED."

400 PRINTLN "TEST OK - NO ERRORS"

410 SLEEP 4