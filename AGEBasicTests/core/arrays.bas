10 DIM A[5]
20 DIM B[2,3]
30 FOR F = 0 TO 4
40   LET A[F] = F
50 NEXT F
60 CLS
70 FOR F = 0 TO 4
80  PRINTLN A[F]
90 NEXT F
92 PRINTLN "LEN:" + STR(LEN(A))

95 SLEEP 2 : CLS
100 FOR F = 0 TO 1
110   FOR G = 0 TO 2
120     LET B[F,G] = STR(F) + "," + STR(G)
130   NEXT G
140 NEXT F

200 FOR F = 0 TO 1
210   FOR G = 0 TO 2
220     PRINT F*5, G+10, B[F,G] 
230   NEXT G
240 NEXT F

300 SLEEP 4

390 REM multi dimension array
400 DIM MULTI[2,3,4]
410 FOR F=0 TO 1
420   FOR G = 0 TO 2
430     FOR X=0 TO 3
440       LET MULTI[F,G,X] = F+G+X
450     NEXT X
460   NEXT G
470 NEXT F
480 IF MULTI[0,0,0] <> 0 THEN CLS:PRINT 0,10, "ERROR MULTI 1" : PRINT "SLEEP" : SLEEP 4: END
490 IF MULTI[1,2,2] <> 1+2+2 THEN CLS:PRINT 0,10, "ERROR MULTI 2" : SLEEP 4: END
500 CLS:PRINTLN "LEN MULTI:"+STR(LEN(MULTI)) : SLEEP 4

550 REM multi type array
560 DIM MULTITYPE[10,2]
570 FOR F=0 TO 9
580   LET MULTITYPE[F,0] = F
590   LET MULTITYPE[F,1] = STR(F)
600 NEXT F
610 CLS
620 FOR F=0 TO 9
630   PRINTLN MULTITYPE[F,0]
640   PRINTLN MULTITYPE[F,1]
650   IF TYPE(MULTITYPE[F,0]) <> "NUMBER" THEN PRINTLN "ERROR MULTITYPE[] SHOULD BE A NUMBER:" + STR(F)
660   IF TYPE(MULTITYPE[F,1]) <> "STRING" THEN PRINTLN "ERROR MULTITYPE[] SHOULD BE A STRING:" + STR(F)
670 NEXT F
680 SLEEP 4

700 IF TYPE(MULTITYPE) <> "ARRAY" THEN PRINTLN "ERROR MULTITYPE SHOULD BE AN ARRAY:" +  TYPE(MULTITYPE)
800 SLEEP 4
 

