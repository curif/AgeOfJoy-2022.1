390 REM multi dimension array
400 DIM MULTI[2,3,4]
410 FOR F=0 TO 1
420   FOR G = 0 TO 2
430     FOR X=0 TO 3
440       LET MULTI[F,G,X] = F+G+X
450     NEXT X
460   NEXT G
470 NEXT F
480 IF MULTI[0,0,0] <> 0 THEN CLS:PRINT 0,10, "ERROR MULTI 1" : SLEEP 4: END
490 IF MULTI[1,2,2] <> 1+2+2 THEN CLS:PRINT 0,10, "ERROR MULTI 2" : SLEEP 4: END
500 CLS:PRINTLN "LEN MULTI:"+STR(LEN(MULTI)) : SLEEP 4

550 REM multi type array
560 DIM MULTITYPE[10,2]
570 FOR F=0 TO 9
580   LET MULTITYPE[F,0] = F
590   LET MULTITYPE[F,1] = STR(F)
600 NEXT F
610 CLS
620 FOR F=0 TO 9
630   PRINTLN MULTITYPE[F,0]
640   PRINTLN MULTITYPE[F,1]
650   IF TYPE(MULTITYPE[F,0]) <> "NUMBER" THEN PRINTLN "ERROR MULTITYPE[] SHOULD BE A NUMBER:" + STR(F)
